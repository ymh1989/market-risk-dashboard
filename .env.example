# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram chat id for the recipient, group, or channel.
TELEGRAM_CHAT_ID=

# 지연·실패 알림 전용 금융공학뉴스 봇과 채팅입니다.
# 일반 리스크뉴스 TELEGRAM_* 값으로 대체하지 않으므로 반드시 별도로 설정합니다.
MARKET_OPERATIONS_TELEGRAM_BOT_TOKEN=
# 여러 채팅은 쉼표로 구분합니다.
MARKET_OPERATIONS_TELEGRAM_CHAT_IDS=

# Digest defaults. The launchd installer uses NEWS_DIGEST_HOUR/MINUTE.
NEWS_DIGEST_LOOKBACK_HOURS=24
NEWS_DIGEST_TOP_PER_TOPIC=4
NEWS_DIGEST_MAX_ITEMS=20
NEWS_DIGEST_HOUR=8
NEWS_DIGEST_MINUTE=30

# 시장리스크 대시보드 한국 표준시 예약
# 월요일 아침은 토요일 전체 갱신과 같은 금요일 종가를 반복하므로 생략합니다.
LOCAL_MARKET_UPDATE_TIMES=07:30,09:00,10:00,11:00,12:00,13:00,14:00,15:00,15:35,18:30
LOCAL_MARKET_UPDATE_MONDAY_TIMES=09:00,10:00,11:00,12:00,13:00,14:00,15:00,15:35,18:30
LOCAL_MARKET_UPDATE_SATURDAY_TIMES=07:30
LOCAL_MARKET_UPDATE_FULL_TIMES=15:35
LOCAL_MARKET_UPDATE_LIVE_TIMES=09:00,10:00,11:00,12:00,13:00,14:00,15:00
LOCAL_MARKET_UPDATE_KRX_TIMES=18:30
LOCAL_MARKET_UPDATE_SCHEDULE_GRACE_MINUTES=10
# 별도 감시기가 5분마다 완료 표식을 확인하고 예상 소요시간+유예시간 초과 시 한 번만 알립니다.
LOCAL_MARKET_UPDATE_WATCHDOG_INTERVAL_SECONDS=300
LOCAL_MARKET_UPDATE_EXPECTED_LIVE_MINUTES=3
LOCAL_MARKET_UPDATE_EXPECTED_FAST_MINUTES=5
LOCAL_MARKET_UPDATE_EXPECTED_FULL_MINUTES=25
LOCAL_MARKET_UPDATE_EXPECTED_KRX_MINUTES=4

# 미국장 EOD 제공처 확정 여유를 둔 야간 사전준비
# LaunchAgent는 화~토 05:40·06:40에 깨우고 뉴욕 DST에 맞는 슬롯 하나만 실행합니다.
OVERNIGHT_PREPARE_GRACE_MINUTES=12
OVERNIGHT_PREPARE_LABEL=com.marketlab.overnight-market-prepare

# SEC Company Facts 요청 식별자. 실제 담당 이메일을 로컬 .env에 입력합니다.
SEC_USER_AGENT=risk-dashboard/1.0 <contact-email>

# FRED 공식 observations API 키입니다. 실제 값은 .env에만 입력합니다.
# 미설정 또는 API 장애 시 공개 CSV, 저장 캐시 순서로 대체합니다.
FRED_API_KEY=

# KB증권 시장 전체 집계정보(IVA10370) 읽기 전용 설정입니다.
# hobby 프로젝트와 키를 공유할 때는 키 자체를 복사하지 말고 해당 .env 경로만 지정할 수 있습니다.
KB_OPENAPI_ENV_FILE=
KB_OPENAPI_BASE_URL=https://developer.kbsec.com:32484
KB_OPENAPI_APP_KEY=
KB_OPENAPI_APP_SECRET=
KB_OPENAPI_TIMEOUT_SECONDS=20
KB_OPENAPI_RETRY_COUNT=3
KB_OPENAPI_IP_ADDR=127.0.0.1
KB_OPENAPI_MAC_ADDR=00-00-00-00-00-00

# 금융투자협회 FreeSIS 공개 증시자금·신용공여 5년 원장입니다.
# 인증정보는 필요하지 않으며 아래 값은 장애 대응 시에만 조정합니다.
KOFIA_FREESIS_BASE_URL=https://freesis.kofia.or.kr
KOFIA_FREESIS_TIMEOUT_SECONDS=25
KOFIA_FREESIS_RETRY_COUNT=3
KOFIA_FREESIS_REQUEST_DELAY_SECONDS=0.25

# KOSPI 시장 내부강도 수집용 KRX 로그인 정보입니다.
# 실제 값은 .env에만 입력하고 저장소에는 커밋하지 않습니다.
KRX_ID=
KRX_PW=
# 기본값: 저장소의 .venv-breadth/bin/python
KOSPI_BREADTH_PYTHON=

# ELS·HMM 지수 장기 일봉의 로컬 증분 캐시입니다. 비우면 data/raw/index_history를 사용합니다.
INDEX_HISTORY_CACHE_DIR=
