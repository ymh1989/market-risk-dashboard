# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram chat id for the recipient, group, or channel.
TELEGRAM_CHAT_ID=

# 야간 운영 실패를 보낼 금융공학뉴스 채팅입니다. 비우면 TELEGRAM_CHAT_ID를 사용합니다.
# 여러 채팅은 쉼표로 구분합니다.
MARKET_OPERATIONS_TELEGRAM_CHAT_IDS=

# Digest defaults. The launchd installer uses NEWS_DIGEST_HOUR/MINUTE.
NEWS_DIGEST_LOOKBACK_HOURS=24
NEWS_DIGEST_TOP_PER_TOPIC=4
NEWS_DIGEST_MAX_ITEMS=20
NEWS_DIGEST_HOUR=8
NEWS_DIGEST_MINUTE=30

# 시장리스크 대시보드 한국 표준시 예약
# 월요일 아침은 토요일 전체 갱신과 같은 금요일 종가를 반복하므로 생략합니다.
LOCAL_MARKET_UPDATE_TIMES=07:30,12:30,15:35
LOCAL_MARKET_UPDATE_MONDAY_TIMES=12:30,15:35
LOCAL_MARKET_UPDATE_SATURDAY_TIMES=07:30
LOCAL_MARKET_UPDATE_FULL_TIMES=15:35
LOCAL_MARKET_UPDATE_SCHEDULE_GRACE_MINUTES=10

# 미국장 EOD 제공처 확정 여유를 둔 야간 사전준비
# LaunchAgent는 화~토 05:40·06:40에 깨우고 뉴욕 DST에 맞는 슬롯 하나만 실행합니다.
OVERNIGHT_PREPARE_GRACE_MINUTES=12
OVERNIGHT_PREPARE_LABEL=com.marketlab.overnight-market-prepare

# SEC Company Facts 요청 식별자. 실제 담당 이메일을 로컬 .env에 입력합니다.
SEC_USER_AGENT=risk-dashboard/1.0 <contact-email>

# FRED 공식 observations API 키입니다. 실제 값은 .env에만 입력합니다.
# 미설정 또는 API 장애 시 공개 CSV, 저장 캐시 순서로 대체합니다.
FRED_API_KEY=

# KOSPI 시장 내부강도 수집용 KRX 로그인 정보입니다.
# 실제 값은 .env에만 입력하고 저장소에는 커밋하지 않습니다.
KRX_ID=
KRX_PW=
# 기본값: 저장소의 .venv-breadth/bin/python
KOSPI_BREADTH_PYTHON=
